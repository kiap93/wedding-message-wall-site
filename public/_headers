# Caching rules for Cloudflare Workers Static Assets
# HTML entry and SPA fallback must revalidate so new frontend deployments are immediately picked up
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Fingerprinted Vite assets can be cached aggressively for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Favicon and root assets
/favicon.png
  Cache-Control: public, max-age=86400, must-revalidate
